# Copy to .env and fill in real values for local dev.
# For Vercel, set these as Project → Settings → Environment Variables
# instead — Vercel doesn't read this repo's .env file in production.
#
# Every integrations/*.py client falls back to illustrative demo data
# whenever its keys are missing or the live call fails, so the app runs
# fine with every optional key below left blank.

# Generate a real one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# False in production. Leave True only for local dev.
DEBUG=True
# Not needed on Vercel — VERCEL_URL is trusted automatically (see settings.py).
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://user:pass@host:5432/dbname — omit for local sqlite.
DATABASE_URL=

# redis://user:pass@host:port — omit to use the in-process cache (fine for
# a single Vercel function instance, but a real Redis is what makes caching
# and rate-limiting actually shared across cold starts/instances).
REDIS_URL=

# Leave both empty to reuse REDIS_URL above automatically.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Must stay True on Vercel — see the comment on this setting in settings.py.
CELERY_TASK_ALWAYS_EAGER=True

# Flights (Travelpayouts / Aviasales — cached market fares, free token)
TRAVELPAYOUTS_TOKEN=

# Hotels, tier 1 (LiteAPI / Nuitee Connect — live rates). Sandbox keys start
# with "sand_"; the dashboard's public/Stripe keys are for widgets/payments
# and will not authenticate here.
LITEAPI_KEY=

# Hotels, tier 3 (StayAPI — real Booking.com data). Free tier is 50 requests
# *total*, so it's the last live tier — see pricing/budget.py's hotel cascade.
STAYAPI_KEY=

# Attractions, fallback tier (OpenTripMap, free, no partner approval needed)
OPENTRIPMAP_API_KEY=

# SerpApi (real Google Flights / Hotels / attractions / search results) —
# the primary tier for flights, hotels and attractions. Free tier is a hard
# 100 searches/month shared across all of it — see integrations/serpapi.py.
SERPAPI_KEY=

# Visa guidance: no key needed. Backed by the open, MIT-licensed Passport
# Index dataset vendored at integrations/data/passport_index_visa.csv —
# refresh it with `python manage.py refresh_visa_data`. Override only if you
# want to point at a different copy of the dataset.
VISA_DATASET_PATH=

# Maps / local transport estimates (Google Maps Routes API)
GOOGLE_MAPS_API_KEY=

# eSIM (eSIM Go — api.esim-go.com)
ESIM_GO_API_KEY=

# Travel insurance (SafetyWing) — no public quote API; kept as a static
# estimate with a disclaimer until/unless partner access is granted.
SAFETYWING_API_KEY=

# Password-reset emails, via Brevo's HTTP API (app.brevo.com > SMTP & API >
# API keys & MCP tab) — not SMTP, which needs an allowlisted IP that Vercel
# Functions can't provide. Leave BREVO_API_KEY blank to print emails to the
# console instead of sending them (fine for local dev, not for real users).
BREVO_API_KEY=
# Must be a sender your Brevo account has verified (Settings > Senders,
# domains, IPs) — sends from anything else are rejected outright.
DEFAULT_FROM_EMAIL=TripPilot AI <your-verified-sender@example.com>

# Google Sign-In (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URIs registered there must match exactly:
# http://127.0.0.1:8000/accounts/google/login/callback/ for local dev, plus
# the real Vercel production URL — see config/settings.py's comment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

RATELIMIT_ENABLE=True
