# Copy to .env and fill in real values as they become available.
# Every integrations/*.py client falls back to illustrative demo data
# whenever its keys are missing or the live call fails, so the app runs
# fine with this file untouched.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL, e.g. postgres://user:pass@host:5432/dbname — omit for local sqlite.
DATABASE_URL=

# REDIS_URL, e.g. redis://default:password@host:port — just the URL, not a
# `redis-cli -u ...` command line. Omit to use the in-process cache.
REDIS_URL=

# Leave both empty to reuse REDIS_URL above automatically (settings.py does
# this in Python, not here — django-environ doesn't expand ${REDIS_URL}).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=True

# Flights + hotels (Amadeus Self-Service, free tier)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Attractions & activities (OpenTripMap, free, no partner approval needed)
OPENTRIPMAP_API_KEY=

# Visa guidance: no key needed. Backed by the open, MIT-licensed Passport
# Index dataset vendored at integrations/data/passport_index_visa.csv —
# refresh it with `python manage.py refresh_visa_data`. Override only if you
# want to point at a different copy of the dataset.
VISA_DATASET_PATH=

# Maps / local transport estimates (Google Maps Distance Matrix)
GOOGLE_MAPS_API_KEY=

# eSIM (eSIM Go — api.esim-go.com, real per-country bundle pricing).
# Falls back to a static per-region-per-day rate (see REGION_SIM_DAILY_RATES
# in pricing/budget.py) when unset, so this is optional.
ESIM_GO_API_KEY=

# Travel insurance (SafetyWing) — no public quote API; kept as a static
# estimate with a disclaimer until/unless partner access is granted.
SAFETYWING_API_KEY=

RATELIMIT_ENABLE=True
